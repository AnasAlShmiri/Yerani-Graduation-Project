        </mxCell>
        <mxCell id="scope-note" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:Noto Sans Arabic;line-height:1.5;text-align:center&quot;&gt;&lt;b&gt;حدود الصلاحيات&lt;/b&gt;&lt;br/&gt;الطبيب: التشخيص والوصفة واعتماد الخطة.&lt;br/&gt;الممرض: العلامات والإجراءات والتقرير فقط.&lt;br/&gt;المريض: استعراض سجله، دون تحرير التوثيق السريري.&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#526574;strokeWidth=1;align=center;verticalAlign=middle;fontSize=18;spacing=14;fontFamily=Noto Sans Arabic;fontColor=#172B3A;" vertex="1" parent="1">
          <mxGeometry x="1260" y="2115" width="460" height="154" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:Noto Sans Arabic;line-height:1.5;text-align:center&quot;&gt;المساعدة الذكية مكوّن داخلي داعم لاقتراح التخصص؛ لا تشخّص ولا تصف علاجًا.&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=fill;align=center;verticalAlign=middle;spacing=0;fontFamily=Noto Sans Arabic;fontColor=#172B3A;fontSize=21;fontColor=#172B3A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="2345" width="1760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:Noto Sans Arabic;line-height:1.5;text-align:center&quot;&gt;تكرار رمز الممثل هو تكرار بصري للهوية نفسها لتجنب تقاطع العلاقات؛ لا يضيف أدوارًا جديدة.&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=fill;align=center;verticalAlign=middle;spacing=0;fontFamily=Noto Sans Arabic;fontColor=#172B3A;fontSize=19;fontColor=#526574;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="2397" width="1760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:Noto Sans Arabic;line-height:1.5;text-align:center&quot;&gt;الخط المتصل: مشاركة الممثل  |  السهم المتقطع: امتداد اختياري من UC-06 إلى UC-04&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=fill;align=center;verticalAlign=middle;spacing=0;fontFamily=Noto Sans Arabic;fontColor=#172B3A;fontSize=19;fontColor=#526574;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="2448" width="1760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:Noto Sans Arabic;line-height:1.5;text-align:center&quot;&gt;لا يتضمن الرسم UC-10 أو الدفع الإلكتروني أو إرسال الإسعاف أو التحليل الطبي الآلي المستقبلي.&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=fill;align=center;verticalAlign=middle;spacing=0;fontFamily=Noto Sans Arabic;fontColor=#172B3A;fontSize=18;fontColor=#526574;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="2495" width="1760" height="38" as="geometry" />
        </mxCell>
      </root>
