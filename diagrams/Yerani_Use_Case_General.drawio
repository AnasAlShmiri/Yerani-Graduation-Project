        <mxCell id="extend-UC06-UC04" value="&lt;div style=&quot;text-align:center;line-height:1.5&quot;&gt;&lt;div dir=&quot;ltr&quot;&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/div&gt;&lt;div dir=&quot;rtl&quot;&gt;[اختيار المريض المساعدة]&lt;/div&gt;&lt;/div&gt;" style="endArrow=open;endFill=0;startArrow=none;dashed=1;dashPattern=7 5;strokeColor=#28536A;strokeWidth=1.6;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;html=1;fontSize=16;fontFamily=Noto Sans Arabic;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="UC-06" target="UC-04">
